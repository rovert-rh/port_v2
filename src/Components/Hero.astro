---
import Badge from "../Components/Global/Badge.astro";
import LinkedInIcon from "../SVG/Icons/LinkedIn.astro";
import MailIcon from "../SVG/Icons/Mail.astro";
import SocialPill from "./SocialPill.astro";
import CVIcon from "../SVG/Icons/CV.astro";
import GitHubIcon from "../SVG/Icons/GitHub.astro";

const personalImageAlt = "Roberto Reyes";
const email = "robertoireyes.m@gmail.com";
---

<div class="max-w-xl">
    <div id="hero-intro" class="flex flex-col gap-6">
        <div
            class="flex flex-col items-center sm:items-start sm:flex-row gap-4"
        >
            <img
                id="hero-image"
                class="rounded-full w-auto shadow-xl size-32 object-cover
                       transition-transform duration-500 hover:scale-[1.02]
                       mx-auto sm:mx-0 mb-4 sm:mb-0"
                src="/RobertoR.webp"
                alt={personalImageAlt}
            />
            <div id="hero-badge" class="flex items-center gap-2">
                <span class="size-3 bg-success rounded-full animate-pulse"
                ></span>
                <Badge class="font-semibold text-base py-3">
                    Disponible para trabajar
                </Badge>
            </div>
        </div>

        <h1
            id="hero-title"
            class="text-4xl font-extrabold tracking-tight sm:text-5xl text-base-content"
        >
            ¡Hola, Soy <span class="text-primary">Roberto Reyes</span>!
        </h1>

        <p
            id="hero-description"
            class="mt-0 text-lg md:text-xl text-base-content/90"
        >
            +8 años de experiencia.
            <strong class="font-semibold text-primary">
                Desarrollador Full-Stack || Especialista en Infraestructura
                Cloud
            </strong>
            en Puebla, México. Especializado en el desarrollo de aplicaciones web
            y despliegue de infraestructura cloud moderna.
        </p>

        <nav id="hero-socials" class="flex flex-wrap gap-3 mt-4">
            <SocialPill
                onclick="document.getElementById('email_modal').showModal()"
            >
                <MailIcon class="size-4" />
                Contáctame
            </SocialPill>

            <SocialPill href="https://www.linkedin.com/in/roberto-reyes-ib/">
                <LinkedInIcon class="size-4" />
                LinkedIn
            </SocialPill>

            <SocialPill
                href="https://drive.google.com/file/d/1zpbQpI-t1f_XCuITsNZ8R9u6akEU8Nwl/view?usp=sharing"
            >
                <CVIcon class="size-4" />
                CV
            </SocialPill>

            <SocialPill href="https://github.com/rovert-rh">
                <GitHubIcon class="size-4" />
                GitHub
            </SocialPill>
        </nav>
    </div>
</div>

<script>
    import { gsap } from "gsap";
    gsap.set(
        [
            "#hero-image",
            "#hero-badge",
            "#hero-title",
            "#hero-description",
            "#hero-socials",
        ],
        { autoAlpha: 0, y: 20 },
    );
    const tl = gsap.timeline();
    tl.to("#hero-image", {
        duration: 0.8,
        autoAlpha: 1,
        y: 0,
        ease: "power3.out",
    })
        .to(
            "#hero-badge",
            {
                duration: 0.6,
                autoAlpha: 1,
                y: 0,
                ease: "power3.out",
            },
            "<0.2",
        )
        .to(
            "#hero-title",
            {
                duration: 0.8,
                autoAlpha: 1,
                y: 0,
                ease: "power3.out",
            },
            "<0.1",
        )
        .to(
            "#hero-description",
            {
                duration: 0.8,
                autoAlpha: 1,
                y: 0,
                ease: "power3.out",
            },
            "<0.1",
        )
        .to(
            "#hero-socials",
            {
                duration: 0.8,
                autoAlpha: 1,
                y: 0,
                ease: "power3.out",
                stagger: 0.1,
            },
            "<0.1",
        );
</script>

<dialog id="email_modal" class="modal">
    <div class="modal-box text-center animate-[fadeInScale_0.3s_ease-out]">
        <form method="dialog">
            <button
                class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
                >✕</button
            >
        </form>
        <h3 class="font-bold text-lg mb-3 text-primary">
            📧 Correo de contacto
        </h3>
        <div class="flex items-center justify-center gap-2 mb-3">
            <input
                id="email_input"
                readonly
                class="input input-bordered w-full max-w-xs text-center font-mono select-none"
                value={email}
            />
            <button
                class="btn btn-primary btn-sm"
                onclick="
          navigator.clipboard.writeText(document.getElementById('email_input').value);
          this.innerText='Copiado!';
          setTimeout(()=>this.innerText='Copiar',1500);
        "
            >
                Copiar
            </button>
        </div>

        <p class="text-sm text-base-content/70">
            Gracias por tu interés. Te responderé lo antes posible 🚀
        </p>

        <div class="modal-action">
            <form method="dialog">
                <button class="btn">Cerrar</button>
            </form>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button>cerrar</button>
    </form>
</dialog>
