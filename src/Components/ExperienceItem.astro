---
import LinkInline from "../SVG/Icons/LinkInline.astro";
import { type Experience } from "../data/types";
interface Props extends Experience {}

const { title, company, description, link, date } = Astro.props;
---

<div
    class="group relative pb-12 grid md:grid-cols-5 md:gap-8 md:space-x-4
        p-4 -mx-4 rounded-xl
        transition duration-300 ease-in-out
        hover:bg-base-300/60
        hover:shadow-lg dark:hover:shadow-primary/10
        hover:scale-[1.01]"
    data-gsap-item
>
    <div class="relative pb-6 md:col-span-2">
        <div class="sticky top-10">
            <h3 class="text-xl font-bold text-primary mb-1">
                {title}
            </h3>
            <h4 class="font-semibold text-lg text-base-content/90">
                {company}
            </h4>

            <time class="p-0 m-0 text-sm italic text-base-content/70"
                >{date}</time
            >
        </div>
    </div>

    <div
        class="relative flex flex-col gap-3 text-base-content/90 dark:text-base-content md:col-span-3 pt-1 md:pt-0"
    >
        {description}
        {
            link && (
                <div class="mt-2">
                    <LinkInline href={link}>
                        Saber más{" "}
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-5 icon icon-tabler icon-tabler-chevron-right transition group-hover:translate-x-1"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M9 6l6 6l-6 6" />
                        </svg>
                    </LinkInline>
                </div>
            )
        }
    </div>
</div>
