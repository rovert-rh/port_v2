---
import AboutMe from "../Components/AboutMe.astro";
import Experience from "../Components/Experience.astro";
import Hero from "../Components/Hero.astro";
import ProjectsGrid from "../Components/Projects/ProjectsGrid.astro";
import Layout from "../Layouts/Layout.astro";
---

<Layout
	title="Roberto Reyes | Ing. Sistemas"
	description="Portafolio Freelancer, ofreciendo servicios de desarrollador web especializado y consultor de TI."
>
	<Hero />
	<section id="experiencia" class="py-16">
		<h2 class="text-4xl font-bold text-center mb-10">Experiencia</h2>
		<Experience />
	</section>

	<section id="proyectos" class="py-16">
		<h2 class="text-4xl font-bold text-center mb-10">Proyectos</h2>
		<ProjectsGrid />
	</section>

	<section id="sobre-mi" class="py-16">
		<h2 class="text-4xl font-bold text-center mb-10">Sobre Mí</h2>
		<AboutMe />
	</section>
</Layout>
