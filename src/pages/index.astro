---
import AboutMe from "../Components/AboutMe.astro";
import ContactForm from "../Components/ContactForm.astro";
import Experience from "../Components/Experience.astro";
import Hero from "../Components/Hero.astro";
import ProjectsGrid from "../Components/Projects/ProjectsGrid.astro";
import Layout from "../Layouts/Layout.astro";
---

<Layout
	title="Roberto Reyes | Ing. Sistemas"
	description="Portafolio Freelancer, ofreciendo servicios de desarrollador web especializado y consultor de TI."
>
	<Hero />

	<section id="experiencia" class="py-16">
		<h2 class="text-4xl font-bold text-center mb-10 section-title-gsap">
			Experiencia
		</h2>
		<Experience />
	</section>

	<section id="proyectos" class="py-16">
		<h2 class="text-4xl font-bold text-center mb-10 section-title-gsap">
			Proyectos
		</h2>
		<ProjectsGrid />
	</section>

	<section id="sobre-mi" class="py-16">
		<h2 class="text-4xl font-bold text-center mb-10 section-title-gsap">
			Sobre Mí
		</h2>
		<AboutMe />
	</section>

	<section id="contacto" class="py-16">
		<h2 class="text-4xl font-bold text-center mb-10 section-title-gsap">
			Hablemos de tu proyecto
		</h2>
		<ContactForm />
	</section>
</Layout>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const titles = document.querySelectorAll(".section-title-gsap");
	gsap.set(titles, {
		autoAlpha: 0,
		y: 30,
	});

	titles.forEach((title) => {
		gsap.to(title, {
			autoAlpha: 1,
			y: 0,
			duration: 1,
			ease: "power3.out",
			scrollTrigger: {
				trigger: title,
				start: "top 85%",
				end: "bottom top",
				toggleActions: "play none none none",
			},
		});
	});
</script>
