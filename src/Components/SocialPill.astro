<a
    {...Astro.props}
    target="_blank"
    rel="noopener noreferrer"
    role="link"
    class="/* BASE: Colores, padding, bordes */
        inline-flex items-center justify-center gap-2 px-4 py-1 text-gray-800 transition rounded-full text-md max-w-fit focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-offset-2
        
        /* Tema Claro */
        bg-gray-100 border border-gray-300 active:bg-black
        /* Tema Oscuro */
        dark:bg-gray-800 dark:border-gray-600 dark:text-white
        /* Transiciones AÑADIDAS */
        duration-300 ease-in-out
        shadow-sm dark:shadow-md dark:shadow-gray-700/50
        
        /* HOVER: Efecto Elevación y Color */
        hover:bg-gray-900 hover:text-white dark:hover:bg-teal-700
        /* AÑADIDO: El Box-Shadow en Hover */
        hover:shadow-lg dark:hover:shadow-teal-500/50"
>
    <slot />
</a>
