---
const currentYear = new Date().getFullYear();
---

<footer class="mt-5 mx-auto w-full max-w-4xl px-4 md:px-0">
    <div
        class="w-full py-4 border-t border-base-content/10
            md:flex md:items-center md:justify-between"
    >
        <span class="text-sm text-base-content/80">
            © {currentYear}
            <a href="/" class="hover:text-primary transition hover:underline">
                Roberto Reyes
            </a>
            <span class="md:inline hidden"> - Desarrollador Freelance.</span>
        </span>

        <ul
            class="flex flex-wrap items-center mt-3 text-sm font-medium sm:mt-0"
        >
            <li>
                <a
                    href="/#sobre-mi"
                    class="text-base-content/70 hover:text-primary transition
                        hover:underline me-4 md:me-6"
                >
                    Contacto
                </a>
            </li>
        </ul>
    </div>
</footer>
