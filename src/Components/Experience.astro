---
import ExperienceItem from "./ExperienceItem.astro";
import experienceData from "../data/experience.json";
---

<section id="experience" class="bg-base-200">
    <ol class="relative max-w-4xl mx-auto px-4">
        {
            experienceData.map((exp) => (
                <li class="mb-10">
                    <ExperienceItem {...exp} />
                </li>
            ))
        }
    </ol>
</section>
