---
import GitHub from "../../SVG/Icons/GitHub.astro";
import Link from "../../SVG/Icons/Link.astro";
import { TAGS } from "../../data/tags";
const { project } = Astro.props;
---

<article
    class="group relative flex flex-col overflow-hidden rounded-2xl shadow-lg border border-gray-800 hover:shadow-2xl transition-all duration-300 bg-gray-900/30"
>
    <a href={`/projects/${project.id}`} class="block">
        <img
            src={project.image}
            alt={project.title}
            class="object-cover w-full h-48 md:h-56 lg:h-64 group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
        />
    </a>
    <div class="flex flex-col flex-grow p-4">
        <h3
            class="text-xl font-bold text-white mb-2 group-hover:text-cyan-400 transition"
        >
            {project.title}
        </h3>
        <p class="text-gray-400 text-sm flex-grow">{project.description}</p>

        <ul class="flex flex-wrap mt-3 gap-2">
            {
                project.tags.map((tagKey) => {
                    const tag = TAGS[tagKey];
                    return (
                        <li>
                            <span
                                class={`flex gap-2 items-center text-xs px-2 py-1 rounded-full ${tag.class}`}
                            >
                                <tag.icon class="size-4" />
                                {tag.name}
                            </span>
                        </li>
                    );
                })
            }
        </ul>

        <div class="flex gap-3 mt-4">
            {
                project.github && (
                    <a
                        href={project.github}
                        target="_blank"
                        class="text-gray-400 hover:text-white flex items-center gap-2"
                    >
                        <GitHub class="size-5" /> Code
                    </a>
                )
            }
            {
                project.link && (
                    <a
                        href={project.link}
                        target="_blank"
                        class="text-gray-400 hover:text-white flex items-center gap-2"
                    >
                        <Link class="size-4" /> Preview
                    </a>
                )
            }
        </div>
    </div>
</article>
